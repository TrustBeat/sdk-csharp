<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>

    <!-- NuGet package metadata -->
    <PackageId>TrustBeat</PackageId>
    <Version>0.2.1</Version>
    <Authors>TrustBeat</Authors>
    <Company>Trustbeat s.r.o.</Company>
    <Description>TrustBeat SDK — qualified timestamping and Merkle anchoring</Description>
    <PackageProjectUrl>https://trustbeat.eu</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eidas;timestamp;rfc3161;merkle;trust;anchoring;qualified</PackageTags>
    <RepositoryUrl>https://github.com/TrustBeat/sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Zero runtime dependencies — BCL only (System.Net.Http, System.Security.Cryptography) -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TrustBeat.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
